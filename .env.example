# The apex domain you own. In local dev, leave as "localhost".
# In production, set to "dnspreviewer.com".
ROOT_DOMAIN=localhost

# Default preview session lifetime, in minutes. Logged-in users can opt for
# no-expiry links, which ignore this.
SESSION_TTL_MINUTES=15

# Max anonymous preview sessions an IP can create per hour. Logged-in users
# have a much higher ceiling.
RATE_LIMIT_PER_HOUR=10

# Optional comma-separated list of target hostnames to block (abuse prevention).
# Example: BLOCKED_HOSTS=mybank.com,paypal.com
BLOCKED_HOSTS=

# Max response body size to buffer for HTML rewriting, in MB.
# Larger responses are streamed through without rewriting.
MAX_REWRITE_MB=4

# Secret for signing auth session cookies and preview unlock cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me-to-a-random-64-char-hex-string

# Path to the SQLite database file. In production, put it on a persistent
# volume so it survives redeploys.
DATABASE_PATH=./data/dnspreviewer.db

# ─── Abuse prevention ───────────────────────────────────────────────────────
# Cloudflare Turnstile. Both keys must be set for the captcha to be enforced on
# anonymous preview creation; leave blank to disable (local dev, self-hosting).
# Get keys at https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Comma-separated hosts to allow through despite being on the built-in
# phishing-target blocklist in lib/blocklist.ts. Only for customers who
# genuinely own a listed domain.
BLOCKED_HOSTS_ALLOW=

# ─── Scheduled jobs ─────────────────────────────────────────────────────────
# Bearer token for /api/cron/* endpoints. Must match the CRON_SECRET secret in
# the GitHub Actions repo settings. Unset = endpoints refuse everything.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# ─── Off-host backups ───────────────────────────────────────────────────────
# Configure either destination, or both. The job writes to every destination
# that is fully configured, and fails if none is.
#
# The database holds user emails, bcrypt password hashes, auth session tokens
# and creator IP addresses. Whatever you point this at MUST be private.

# Destination A: a PRIVATE GitHub repository. Never the public app repo.
# Token needs Contents: read and write on that one repository only.
BACKUP_GITHUB_TOKEN=
BACKUP_GITHUB_REPO=
BACKUP_GITHUB_BRANCH=main
BACKUP_GITHUB_PREFIX=backups
# GitHub has no lifecycle rules, so the job prunes its own history.
BACKUP_GITHUB_KEEP=90

# Destination B: any S3-compatible bucket (Cloudflare R2, Backblaze B2, S3).
# Set a lifecycle rule on the bucket for retention; the app never deletes here.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_REGION=auto
BACKUP_S3_PREFIX=dnspreviewer

# Encryption at rest, applied before the dump leaves the machine.
# 64 hex characters (32 bytes), AES-256-GCM. Leave blank to upload plain gzip.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep a copy in your password manager. Lose it and the backups are gone.
BACKUP_ENCRYPTION_KEY=
